rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Shifts collection - read & write for real-time synchronization
    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    // Staff collection - read & write for real-time synchronization
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Generic document catch for app state collections
    match /appState/{docId} {
      allow read, write: if true;
    }
  }
}
